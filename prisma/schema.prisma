generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Follower {
  id          String @id @default(uuid())
  followerId  String
  followingId String
  follower    User   @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("UserFollowings", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Post {
  id          String           @id @default(uuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments PostAttachment[]
  comments    PostComment[]
  likes       PostLike[]
}

model PostLike {
  id     String @id @default(uuid())
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostComment {
  id      String             @id @default(uuid())
  userId  String
  postId  String
  comment String
  post    Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies PostCommentReply[]
}

model PostCommentReply {
  id             String      @id @default(uuid())
  replyerId      String
  postId         String
  comment        String
  commentReplied PostComment @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyer        User        @relation(fields: [replyerId], references: [id], onDelete: Cascade)
}

model PostAttachment {
  id             String         @id @default(uuid())
  postId         String
  attachmentLink String
  type           AttachmentType
  post           Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model User {
  id                 String             @id @default(uuid())
  firstname          String
  lastname           String
  username           String             @unique
  email              String             @unique
  password           String?
  provider           Providers          @default(email)
  profilePic         String             @default("default_pic_url")
  followings          Follower[]         @relation("UserFollowings")
  followers          Follower[]         @relation("UserFollowers")
  posts              Post[]
  postComment        PostComment[]
  postCommentReplies PostCommentReply[]
  postLike           PostLike[]
  sessions      Session[]
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Providers {
  google
  email
}

enum AttachmentType {
  image
  video
}
